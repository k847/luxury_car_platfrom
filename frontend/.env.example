# =============================================================
# 段功能：前端环境变量样例（M1 配置）
# 说明：复制为 .env 后按本机修改。VITE_ 前缀变量会注入到前端构建。
# =============================================================

# 后端 API 基址（开发期也可走 Vite 代理 /api，但这里直连便于联调）
VITE_API=http://localhost:8000

# 地图 SDK Key（M5/D5 经销商地图使用）
VITE_MAP_KEY=

# 图片 CDN 基址
CDN_BASE=
