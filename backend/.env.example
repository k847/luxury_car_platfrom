# =============================================================
# 段功能：后端环境变量样例（M1 配置）
# 说明：复制为 .env 后填入真实值。字段对齐《开发技术文档》附录 D。
#       切勿把真实 .env 提交到 Git（已含密钥）。
# =============================================================

# 数据库（MySQL 8）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=luxury_car

# Redis（限流 / refresh token，M1 先预留）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET=change-me-in-prod
ACCESS_TOKEN_EXPIRE=3600
REFRESH_TOKEN_EXPIRE=604800

# CORS（前台域名白名单，逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 运行环境 dev / staging / prod
ENV=dev

# 全局接口前缀（前端请求默认 /api/v1）
API_PREFIX=/api
