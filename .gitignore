# =============================================================
# 段功能：豪华车聚合选车平台 Git 忽略规则（基于实际项目结构）
# 说明：项目结构为 backend/（Python FastAPI 服务端）+ frontend/（React/Vite 前台，
#       后台管理 SPA 亦在 frontend/src/pages/admin/）。无 api/ 目录。
# =============================================================

# ============ Python 虚拟环境 ============
# backend/ 下的 Python 服务端使用 venv；以下规则递归忽略任意层级的 venv 目录
.venv/
venv/
env/
ENV/

# ============ Python 缓存 / 构建产物 ============
__pycache__/
*.py[cod]
*$py.class
.Python
pip-log.txt
*.egg-info/
.pytest_cache/
.mypy_cache/

# ============ 环境变量（含密钥，勿提交） ============
# 保留 .env.example 作为配置样例（可提交）
.env
.env.local
.env.*.local

# ============ Node.js 依赖目录 ============
# frontend/ 为 Node(Vite) 工程，node_modules 体积大且不入库
node_modules/

# ============ 前端构建产物 ============
# frontend/ 构建后生成的 dist 目录（及 Vite 的 SSR 产物）不入库
dist/
dist-ssr/

# ============ 编辑器 / 系统文件 ============
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
